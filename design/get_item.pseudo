# Project One Get-Item Pseudocode
#
# Graded checkpoint: Module Five Project One
# Later use: get-item and inventory design for M7 Project Two
#
# Review the course-provided get-item flowchart before completing this file.
# Write pseudocode, not Python code. Use clear indentation and course-appropriate
# keywords such as INPUT, OUTPUT, IF, ELSE, SET, ADD, or similar terms.

FUNCTION collect_equipment(player, room, characters)

    LET enemy_name EQUAL room enemy

    IF enemy_name IS NOT NONE
        LET enemy EQUAL character matching enemy_name

        IF enemy IS alive
            PUT "You can't open the chest while enemy is guarding it!"
            RETURN
        END IF
    END IF

    IF room HAS an item
        LET item EQUAL room item

        ADD item TO player equipment

        IF item target EQUALS "self" AND item stat DOES NOT EQUAL "recovery"
            MODIFY player stats using item
        END IF

        SET room description EQUAL room empty description
        SET room item EQUAL NONE

        PUT "You collected item!"
    ELSE
        PUT "There is nothing to collect."
    END IF

END FUNCTION
