# Project One Move-Between-Rooms Pseudocode
#
# Graded checkpoint: Module Five Project One
# Later use: conceptual support for M6; movement design for M7
#
# Review the course-provided movement flowchart before completing this file.
# Write pseudocode, not Python code. Use clear indentation and course-appropriate
# keywords such as INPUT, OUTPUT, IF, ELSE, WHILE, SET, or similar terms.

FUNCTION try_moving(current_room, rooms, direction)

    LET room EQUAL current room

    IF direction IS NOT in room exits
        RETURN current_room AND "You can't travel in that direction."
    END IF

    IF direction IS in room locked exits
        RETURN current_room AND "That way is locked."
    END IF

    SET current_room EQUAL room exit matching direction
    LET description EQUAL current room description

    RETURN current_room AND description

END FUNCTION


ELSE IF command EQUALS "move"

    LET enemy_name EQUAL room enemy

    IF enemy_name IS NOT NONE AND enemy IS alive
        PUT "The enemy blocks your path! You must Attack or Run."

    ELSE
        PUT available room exits

        GET direction from user INPUT
        CONVERT direction to lowercase
        REMOVE extra spaces from direction
        CORRECT direction INPUT using valid directions

        IF direction IS "north", "south", "east", "west", "up", OR "down"

            LET new_room AND description EQUAL result of trying to move

            IF new_room DOES NOT EQUAL current_room
                SET current_room EQUAL new_room

                IF current_room EQUALS "Entrance"
                    CHECK for hidden room
                END IF
            END IF

            PUT description

            IF current_room EQUALS "Mom's Room"
                PUT secret victory message
                SET running EQUAL FALSE
            END IF

        ELSE
            PUT "That is not a valid direction."
        END IF
    END IF